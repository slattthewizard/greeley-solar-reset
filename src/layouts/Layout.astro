---
export interface Props {
  title: string;
  description: string;
  canonical: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
}

const {
  title,
  description,
  canonical,
  ogTitle,
  ogDescription,
  ogImage = 'https://greeleysolarreset.com/images/og-image.webp',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" href="/favicon.png" type="image/png">
  <link rel="apple-touch-icon" href="/logo-mark.png">
  <title>{title}</title>
  <meta name="google-site-verification" content="kTSRtazkkHfvVT4s5BWrhaB1ZY4gz9w1dyQU4sscFXM" />
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={ogTitle ?? title} />
  <meta property="og:description" content={ogDescription ?? description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content="Greeley Solar Reset" />
  <meta property="og:locale" content="en_US" />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={ogTitle ?? title} />
  <meta name="twitter:description" content={ogDescription ?? description} />
  <meta name="twitter:image" content={ogImage} />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@700;800&family=DM+Sans:wght@400;500;700&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@700;800&family=DM+Sans:wght@400;500;700&display=swap"></noscript>

  <!-- Shared base styles -->
  <style is:global>
    :root {
      --accent: #E8A020;        /* sun-gold amber */
      --accent-dark: #C9861A;
      --accent-tint: #FBF2DF;
      --accent-deep: #8F5D0C;   /* AA-safe amber for text on light bgs */
      --glow: rgba(232,160,32,0.35);
      --charcoal: #16202E;      /* dark hero / headings */
      --slate: #24374B;
      --ink: #4A5560;           /* body text */
      --muted: #7A8490;
      --light: #F1F3F6;         /* alternating section bg */
      --footer: #0C1219;
      --line: #E5E8EE;
      --shadow-sm: 0 1px 3px rgba(22,32,46,0.08);
      --shadow-md: 0 4px 20px rgba(22,32,46,0.10);
      --shadow-lg: 0 10px 40px rgba(22,32,46,0.12);
      --shadow-xl: 0 20px 60px rgba(22,32,46,0.15);
      --radius-md: 12px;
      --radius-lg: 20px;
      --font-heading: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      --font-body: 'DM Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body { font-family: var(--font-body); color: var(--ink); background: #fff; margin: 0; font-size: 16px; line-height: 1.7; }
    h1, h2, h3, h4 { font-family: var(--font-heading); color: var(--charcoal); }

    .container { max-width: 1180px; margin: 0 auto; padding-left: 24px; padding-right: 24px; }
    .section-pad { padding: 80px 0; }
    .section-pad-lg { padding: 100px 0; }
    .bg-light { background: var(--light); }

    /* Nav */
    .nav-link {
      font-family: var(--font-body); font-weight: 500; font-size: 15px; color: var(--ink); text-decoration: none;
      padding: 8px 2px; transition: color 0.2s;
    }
    .nav-link:hover { color: var(--charcoal); }
    .nav-link:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; border-radius: 2px; }

    /* Dropdowns */
    .dropdown-open .svc-dropdown { opacity:1 !important; visibility:visible !important; transform:translateY(0) !important; }
    .dropdown-open svg { transform: rotate(180deg); }
    .areas-open .areas-dropdown { opacity:1 !important; visibility:visible !important; transform:translateY(0) !important; }
    .areas-open svg { transform: rotate(180deg); }
    .dropdown-link { display: flex; align-items: center; padding: 11px 18px; min-height: 44px; font-size: 14px; font-weight: 500; color: var(--ink); text-decoration: none; transition: background-color 0.2s, color 0.2s; outline: none; }
    .dropdown-link:hover { background-color: var(--accent-tint); color: var(--charcoal); }
    .dropdown-link:focus-visible { background-color: var(--accent-tint); color: var(--charcoal); box-shadow: inset 2px 0 0 0 var(--accent); }
    .dropdown-link:active { opacity: 0.7; }

    /* Pill buttons — accent primary (dark text for AA contrast on gold) */
    .btn-green {
      display: inline-flex; align-items: center; justify-content: center; gap: 8px;
      background: var(--accent); color: var(--charcoal); font-family: var(--font-heading);
      font-weight: 700; font-size: 15px; letter-spacing: 0.3px;
      padding: 16px 36px; border: none; border-radius: 50px; cursor: pointer; text-decoration: none;
      transition: background 0.2s, transform 0.15s, box-shadow 0.2s;
      box-shadow: 0 4px 20px var(--glow);
    }
    .btn-green:hover { background: var(--accent-dark); transform: translateY(-1px); box-shadow: 0 8px 26px var(--glow); }
    .btn-green:active { transform: translateY(0); }
    .btn-green:focus-visible { outline: 3px solid var(--accent-tint); outline-offset: 2px; }

    .btn-blue, .btn-primary {
      display: inline-flex; align-items: center; justify-content: center; gap: 8px;
      background: var(--charcoal); color: #fff; font-family: var(--font-heading);
      font-weight: 700; font-size: 15px; letter-spacing: 0.3px;
      padding: 16px 36px; border: none; border-radius: 50px; cursor: pointer; text-decoration: none;
      transition: background 0.2s, transform 0.15s;
    }
    .btn-blue:hover, .btn-primary:hover { background: var(--slate); transform: translateY(-1px); }
    .btn-blue:active, .btn-primary:active { transform: translateY(0); }
    .btn-blue:focus-visible, .btn-primary:focus-visible { outline: 3px solid var(--accent-tint); outline-offset: 2px; }

    .btn-white-outline, .btn-outline-white {
      display: inline-flex; align-items: center; justify-content: center; gap: 8px;
      background: rgba(255,255,255,0.06); color: #fff; font-family: var(--font-heading);
      font-weight: 700; font-size: 15px; padding: 15px 34px;
      border: 1.5px solid rgba(255,255,255,0.35); border-radius: 50px; cursor: pointer; text-decoration: none;
      transition: background 0.2s, transform 0.15s, border-color 0.2s; backdrop-filter: blur(2px);
    }
    .btn-white-outline:hover, .btn-outline-white:hover { background: rgba(255,255,255,0.14); border-color: rgba(255,255,255,0.6); transform: translateY(-1px); }
    .btn-white-outline:active, .btn-outline-white:active { transform: translateY(0); }
    .btn-white-outline:focus-visible, .btn-outline-white:focus-visible { outline: 3px solid var(--glow); outline-offset: 2px; }

    .btn-copper, .btn-bark {
      display: inline-flex; align-items: center; justify-content: center; gap: 8px;
      background: var(--accent); color: var(--charcoal); font-family: var(--font-heading);
      font-weight: 700; font-size: 15px; padding: 16px 36px; border: none;
      border-radius: 50px; cursor: pointer; text-decoration: none;
      transition: background 0.2s, transform 0.15s; box-shadow: 0 4px 20px var(--glow);
    }
    .btn-copper:hover, .btn-bark:hover { background: var(--accent-dark); transform: translateY(-1px); }
    .btn-cream {
      display: inline-flex; align-items: center; justify-content: center; gap: 8px;
      background: #fff; color: var(--charcoal); font-family: var(--font-heading);
      font-weight: 700; font-size: 15px; padding: 16px 36px; border: none;
      border-radius: 50px; cursor: pointer; text-decoration: none;
      transition: transform 0.15s, box-shadow 0.2s; box-shadow: 0 6px 18px rgba(0,0,0,0.18);
    }
    .btn-cream:hover { transform: translateY(-1px); box-shadow: 0 10px 26px rgba(0,0,0,0.24); }

    /* Eyebrow pill above every H2 */
    .kicker, .section-tag {
      display: inline-block; font-family: var(--font-heading); font-size: 12px; font-weight: 700;
      letter-spacing: 1.2px; text-transform: uppercase; color: var(--accent-deep);
      background: var(--accent-tint); padding: 6px 18px; border-radius: 50px; margin-bottom: 18px;
    }
    .kicker-dark {
      display: inline-block; font-family: var(--font-heading); font-size: 12px; font-weight: 700;
      letter-spacing: 1.2px; text-transform: uppercase; color: var(--accent);
      background: rgba(232,160,32,0.12); border: 1px solid rgba(232,160,32,0.3);
      padding: 6px 18px; border-radius: 50px; margin-bottom: 18px;
    }
    .section-heading {
      font-family: var(--font-heading); font-weight: 800; color: var(--charcoal);
      line-height: 1.2; letter-spacing: -0.5px;
    }

    /* Cards */
    .card { background: #fff; border-radius: var(--radius-lg); box-shadow: var(--shadow-sm), var(--shadow-lg); }

    /* FAQ accordion */
    .faq-item { background: #fff; border: 1px solid var(--line); border-radius: 14px; overflow: hidden; }
    .faq-item summary {
      list-style: none; cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: 16px;
      padding: 20px 26px; font-family: var(--font-heading); font-size: 17px; font-weight: 700; color: var(--charcoal);
    }
    .faq-item summary::-webkit-details-marker { display: none; }
    .faq-item summary::after {
      content: '+'; flex-shrink: 0; width: 28px; height: 28px; border-radius: 50%;
      background: var(--accent-tint); color: var(--accent-deep); font-size: 18px; font-weight: 700;
      display: flex; align-items: center; justify-content: center; transition: transform 0.2s;
    }
    .faq-item[open] summary::after { transform: rotate(45deg); }
    .faq-item p { padding: 0 26px 22px; margin: 0; font-size: 15px; line-height: 1.75; color: var(--ink); }
    .faq-item summary:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }

    /* City pill chips */
    .chip {
      display: inline-flex; align-items: center; gap: 6px;
      background: #fff; border: 1px solid var(--line); border-radius: 50px;
      padding: 12px 24px; font-family: var(--font-heading); font-size: 14px; font-weight: 700;
      color: var(--charcoal); text-decoration: none; box-shadow: var(--shadow-sm);
      transition: border-color 0.2s, transform 0.15s, box-shadow 0.2s;
    }
    .chip:hover { border-color: var(--accent); transform: translateY(-1px); box-shadow: var(--shadow-md); }

    /* Form fields */
    .gsr-field { display: flex; flex-direction: column; gap: 5px; }
    .gsr-field label { font-family: var(--font-heading); font-size: 13px; font-weight: 700; color: var(--charcoal); }
    .gsr-field input, .gsr-field textarea {
      padding: 12px 16px; border: 1.5px solid var(--line); border-radius: var(--radius-md);
      font-family: var(--font-body); font-size: 15px; min-height: 46px; color: var(--charcoal);
      transition: border-color 0.2s; width: 100%;
    }
    .gsr-field textarea { min-height: 0; resize: vertical; }
    .gsr-field input:focus, .gsr-field textarea:focus { outline: none; border-color: var(--accent); }

    /* Curved divider (legacy, unused by current skin) */
    .swoosh { display: block; width: 100%; height: 70px; margin-top: -1px; }

    /* Footer */
    .footer-head {
      font-family: var(--font-heading); font-size: 11px; font-weight: 700; color: rgba(255,255,255,0.35);
      letter-spacing: 1.1px; text-transform: uppercase; margin: 0 0 18px;
    }
    .footer-link {
      font-size: 14px; color: rgba(255,255,255,0.6); text-decoration: none;
      transition: color 0.2s; outline: none; display: inline-block;
    }
    .footer-link:hover { color: #fff; }
    .footer-link:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 2px; color: #fff; }

    /* Mobile nav */
    #mobile-menu { display: none; }
    #mobile-menu.open { display: block; }
    .desktop-nav { display: none; }
    .menu-btn { display: inline-flex; }
    @media (min-width: 960px) {
      .desktop-nav { display: flex; }
      .menu-btn { display: none; }
      .desktop-cta { display: inline-flex !important; }
    }

    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: var(--light); }
    ::-webkit-scrollbar-thumb { background: var(--accent-dark); border-radius: 3px; }
  </style>

  <!-- Page-specific head content (schema, extra styles) -->
  <slot name="head" />

  <script>document.addEventListener('click',function(e){document.querySelectorAll('.dropdown-open').forEach(function(d){if(!d.contains(e.target))d.classList.remove('dropdown-open')});document.querySelectorAll('.areas-open').forEach(function(d){if(!d.contains(e.target))d.classList.remove('areas-open')})});</script>
</head>
<body>

<!-- ANNOUNCEMENT STRIP -->
<div style="background:#0C1219;padding:8px 24px;">
  <div style="max-width:1180px;margin:0 auto;display:flex;align-items:center;justify-content:center;gap:28px;flex-wrap:wrap;">
    <span style="color:rgba(255,255,255,0.85);font-size:12.5px;font-weight:500;display:flex;align-items:center;gap:6px;">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#E8A020" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      Reroofing? Solar detached & reset on your schedule
    </span>
    <span style="color:rgba(255,255,255,0.55);font-size:12.5px;font-weight:500;" class="strip-extra">Serving Greeley &amp; Weld County</span>
    <a href="tel:+19702863417" style="color:#E8A020;font-size:12.5px;font-weight:700;font-family:'Plus Jakarta Sans',sans-serif;text-decoration:none;display:flex;align-items:center;gap:6px;">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.5 12 19.79 19.79 0 0 1 1.1 3.18a2 2 0 0 1 2-2.18h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.27a16 16 0 0 0 7.82 7.82l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
      (970) 286-3417
    </a>
  </div>
</div>
<style>
  @media (max-width: 640px) { .strip-extra { display: none; } }
</style>

<!-- STICKY NAV -->
<header style="position:sticky;top:0;z-index:100;background:#fff;box-shadow:0 2px 14px rgba(22,32,46,0.08);">
  <div style="max-width:1180px;margin:0 auto;padding:0 24px;display:flex;align-items:center;justify-content:space-between;height:76px;">
    <!-- Logo -->
    <a href="/" style="display:flex;align-items:center;gap:10px;text-decoration:none;" aria-label="Greeley Solar Reset home">
      <img src="/logo-mark.png" alt="" width="44" height="44" style="display:block;" aria-hidden="true" />
      <span style="display:flex;flex-direction:column;line-height:1.05;">
        <span style="font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:19px;color:#16202E;letter-spacing:-0.3px;">Greeley Solar Reset</span>
        <span style="font-family:'Plus Jakarta Sans',sans-serif;font-size:9.5px;font-weight:700;letter-spacing:1.1px;text-transform:uppercase;color:#8F5D0C;">Solar Detach &amp; Reset for Roof Replacement</span>
      </span>
    </a>

    <!-- Desktop Nav -->
    <nav class="desktop-nav" style="align-items:center;gap:26px;">
      <div style="position:relative;">
        <button onclick="this.parentElement.classList.toggle('dropdown-open')" class="nav-link" style="background:none;border:none;cursor:pointer;display:flex;align-items:center;gap:5px;min-height:44px;">
          Services
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="transition:transform 0.2s;"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <div class="svc-dropdown" style="position:absolute;top:calc(100% + 6px);left:0;min-width:260px;background:#fff;border-radius:14px;box-shadow:0 8px 30px rgba(22,32,46,0.16);padding:8px 0;opacity:0;visibility:hidden;transform:translateY(-8px);transition:opacity 0.2s,transform 0.2s,visibility 0.2s;z-index:100;overflow:hidden;">
          <a href="/solar-detach-reset-greeley/" class="dropdown-link">Solar Detach & Reset</a>
          <a href="/solar-panel-removal-greeley/" class="dropdown-link">Solar Panel Removal</a>
          <a href="/solar-hail-damage-greeley/" class="dropdown-link">Hail Damage Inspection & Repair</a>
          <a href="/emergency-solar-service-greeley/" class="dropdown-link">Storm Damage Response</a>
        </div>
      </div>
      <div style="position:relative;">
        <button onclick="this.parentElement.classList.toggle('areas-open')" class="nav-link" style="background:none;border:none;cursor:pointer;display:flex;align-items:center;gap:5px;min-height:44px;">
          Service Areas
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="transition:transform 0.2s;"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <div class="areas-dropdown" style="position:absolute;top:calc(100% + 6px);left:0;min-width:230px;background:#fff;border-radius:14px;box-shadow:0 8px 30px rgba(22,32,46,0.16);padding:8px 0;opacity:0;visibility:hidden;transform:translateY(-8px);transition:opacity 0.2s,transform 0.2s,visibility 0.2s;z-index:100;overflow:hidden;">
          <a href="/solar-detach-reset-evans/" class="dropdown-link">Evans</a>
          <a href="/solar-detach-reset-windsor/" class="dropdown-link">Windsor</a>
          <a href="/solar-detach-reset-johnstown/" class="dropdown-link">Johnstown</a>
          <a href="/solar-detach-reset-eaton/" class="dropdown-link">Eaton</a>
          <a href="/solar-detach-reset-firestone/" class="dropdown-link">Firestone</a>
          <a href="/solar-detach-reset-fort-lupton/" class="dropdown-link">Fort Lupton</a>
        </div>
      </div>
      <a href="/solar-panel-removal-reinstall-cost/" class="nav-link">Cost Guide</a>
      <a href="/about/" class="nav-link">About</a>
      <a href="/blog/" class="nav-link">Blog</a>
    </nav>

    <!-- CTA -->
    <div class="desktop-cta" style="display:none;align-items:center;gap:18px;">
      <a href="tel:+19702863417" style="display:flex;align-items:center;gap:7px;text-decoration:none;font-family:'Plus Jakarta Sans',sans-serif;font-weight:800;font-size:15px;color:#16202E;">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.5 12 19.79 19.79 0 0 1 1.1 3.18a2 2 0 0 1 2-2.18h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.27a16 16 0 0 0 7.82 7.82l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        (970) 286-3417
      </a>
      <a href="/#contact" class="btn-green" style="padding:12px 24px;font-size:13px;letter-spacing:0.26px;">Free Estimate</a>
    </div>

    <!-- Mobile hamburger -->
    <button class="menu-btn" onclick="document.getElementById('mobile-menu').classList.toggle('open')" aria-label="Toggle menu" style="background:none;border:none;cursor:pointer;padding:12px;min-width:44px;min-height:44px;color:#16202E;">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
    </button>
  </div>

  <!-- Mobile Nav -->
  <div id="mobile-menu" style="border-top:1px solid #E5E8EE;background:#fff;">
    <nav style="display:flex;flex-direction:column;padding:16px 24px;gap:14px;">
      <a href="/solar-detach-reset-greeley/" class="nav-link" onclick="document.getElementById('mobile-menu').classList.remove('open')">Solar Detach & Reset</a>
      <a href="/solar-panel-removal-greeley/" class="nav-link" onclick="document.getElementById('mobile-menu').classList.remove('open')">Solar Panel Removal</a>
      <a href="/solar-hail-damage-greeley/" class="nav-link" onclick="document.getElementById('mobile-menu').classList.remove('open')">Hail Damage Inspection & Repair</a>
      <a href="/emergency-solar-service-greeley/" class="nav-link" onclick="document.getElementById('mobile-menu').classList.remove('open')">Emergency Service</a>
      <a href="/solar-panel-removal-reinstall-cost/" class="nav-link" onclick="document.getElementById('mobile-menu').classList.remove('open')">Cost Guide</a>
      <a href="/about/" class="nav-link" onclick="document.getElementById('mobile-menu').classList.remove('open')">About</a>
      <a href="/blog/" class="nav-link" onclick="document.getElementById('mobile-menu').classList.remove('open')">Blog</a>
      <a href="/#contact" class="btn-green" style="width:fit-content;font-size:13px;padding:11px 24px;" onclick="document.getElementById('mobile-menu').classList.remove('open')">Free Estimate</a>
    </nav>
  </div>
</header>

<!-- PAGE CONTENT -->
<slot />

<!-- FOOTER -->
<footer style="background:#0C1219;color:rgba(255,255,255,0.6);padding:0;">
  <div style="max-width:1180px;margin:0 auto;padding:64px 24px 0;">
    <div class="footer-grid" style="display:grid;grid-template-columns:2fr 1fr 1fr 1.4fr;gap:48px;padding-bottom:48px;border-bottom:1px solid rgba(255,255,255,0.08);">
      <!-- Brand -->
