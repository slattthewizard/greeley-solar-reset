<script type="application/ld+json">{"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://greeleysolarreset.com/"}, {"@type": "ListItem", "position": 2, "name": "About", "item": "https://greeleysolarreset.com/about/"}]}</script>
<script type="application/ld+json">{"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "Are you connected to my original solar installer?", "acceptedAnswer": {"@type": "Answer", "text": "No, we're an independent detach and reset company. That matters because many installers are booked out for weeks on removal work or charge a premium for it. We work on most residential rooftop systems regardless of who installed them, and if we find something we can't service, we'll tell you up front."}}, {"@type": "Question", "name": "Do you work directly with my roofer and my insurance adjuster?", "acceptedAnswer": {"@type": "Answer", "text": "Yes, and it usually makes the whole reroof smoother. We coordinate timing with your roofing crew so the panels are off before tear-off day, and we provide the documentation and line items adjusters expect. You can read more about how pricing works on our <a href=\"/solar-panel-removal-reinstall-cost/\">removal and reinstall cost page</a>."}}, {"@type": "Question", "name": "What if the hail damaged my panels, not just my roof?", "acceptedAnswer": {"@type": "Answer", "text": "We inspect every panel during the detach and flag anything that looks compromised, with photos, so damaged equipment can be added to your claim instead of going back on a brand new roof. Our <a href=\"/solar-hail-damage-greeley/\">solar hail damage page</a> covers what we look for and what your options are."}}]}</script>
