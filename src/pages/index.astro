  .gsr-grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .gsr-grid-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 22px; }
  @media (max-width: 1000px) { .gsr-grid-4 { grid-template-columns: repeat(2, 1fr); } .gsr-grid-3 { grid-template-columns: 1fr; } }
  @media (max-width: 760px) { .gsr-grid-2 { grid-template-columns: 1fr; } .gsr-grid-4 { grid-template-columns: 1fr; } }
</style>
