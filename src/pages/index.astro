<!-- SERVICES -->
<section class="section-pad bg-light" id="services">
  <div class="container">
    <div style="text-align:center;max-width:820px;margin:0 auto 48px;">
    <span class="kicker">Our Services</span>
    <h2 class="section-heading" style="font-size:clamp(28px,3.4vw,40px);margin:0 0 14px;">Solar Panel Removal &amp; Reset Services in Greeley</h2>
    <p style="font-size:17px;line-height:1.7;color:#4A5560;max-width:640px;margin:0 auto;">From full detach and reset to permanent removal and hail claims, one crew handles the solar side of your reroof.</p>
  </div>
    <div class="gsr-grid-2">
      <div class="card" style="display:flex;flex-direction:column;overflow:hidden;">
        <img src="/images/service-1-800.webp" alt="Solar Detach & Reset in Greeley, CO" width="800" height="533" style="width:100%;height:auto;aspect-ratio:16/9;object-fit:cover;display:block;" loading="lazy">
        <div style="display:flex;flex-direction:column;flex:1;padding:28px 30px 30px;">
          <h3 style="font-size:22px;font-weight:800;margin:0 0 10px;">Solar Detach & Reset</h3>
